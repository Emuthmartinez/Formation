{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true
  },
  "include": [
    "skill/formation/core/**/*.ts",
    "skill/formation/verification/**/*.ts",
    "skill/formation/validation/business/**/*.ts",
    "skill/formation/validation/repository/**/*.ts",
    "skill/formation/tooling/**/*.ts",
    "skill/formation/catalog/**/*.ts"
  ]
}
