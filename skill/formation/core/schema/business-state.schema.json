{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:formation:core:business-state-schema",
  "title": "Business State v2",
  "$comment": "Successor of state/PROJECT_STATE.yaml (v1, schema_version \"1\"). Autonomy (mode + founder_only_gates) moves out of state entirely into control.json/grants/waivers/budget-ledger (KTD5); state v2 keeps project identity, narrative, lane progress against the shared status vocabulary, and a founderGates.pending list that a migration demotes legacy gates into, never auto-approved. Lane objects allow additional properties for lane-specific fields (e.g. attribution contract, kill-or-scale decision) that this schema does not enumerate one by one.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "updatedAt", "narrative", "project", "lanes", "founderGates"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "2.0.0" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "narrative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sinceLastTime", "rightNow", "yourCall", "lastCelebratedPhase"],
      "properties": {
        "sinceLastTime": { "type": "string" },
        "rightNow": { "type": "string" },
        "yourCall": { "type": "string" },
        "lastCelebratedPhase": { "type": "string" }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "slug", "owner", "phase", "launchScope", "platforms", "bundleIds", "publicUrls"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "minLength": 1 },
        "owner": { "type": "string" },
        "phase": { "type": "string", "pattern": "^phase_" },
        "launchScope": { "enum": ["essentials", "full"] },
        "kickoffDate": { "anyOf": [{ "const": "" }, { "type": "string" }] },
        "platforms": { "type": "array", "items": { "enum": ["ios", "android"] }, "minItems": 1, "uniqueItems": true },
        "bundleIds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ios", "android"],
          "properties": { "ios": { "type": "string" }, "android": { "type": "string" } }
        },
        "publicUrls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["landing", "privacy", "terms"],
          "properties": { "landing": { "type": "string" }, "privacy": { "type": "string" }, "terms": { "type": "string" } }
        }
      }
    },
    "lanes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paid_tool_routing",
        "secrets",
        "security",
        "research",
        "traceability",
        "experience",
        "product",
        "design",
        "emotional_design",
        "content_assets",
        "analytics_attribution",
        "paid_user_acquisition",
        "onboarding",
        "revenue",
        "store_console",
        "apple_signing",
        "privacy_legal",
        "email",
        "orchestration",
        "engineering",
        "growth",
        "post_launch_ops"
      ],
      "properties": {
        "paid_tool_routing": { "$ref": "#/$defs/lane" },
        "secrets": { "$ref": "#/$defs/lane" },
        "security": { "$ref": "#/$defs/lane" },
        "research": { "$ref": "#/$defs/lane" },
        "traceability": { "$ref": "#/$defs/lane" },
        "experience": { "$ref": "#/$defs/lane" },
        "product": { "$ref": "#/$defs/lane" },
        "design": { "$ref": "#/$defs/lane" },
        "emotional_design": { "$ref": "#/$defs/lane" },
        "content_assets": { "$ref": "#/$defs/lane" },
        "analytics_attribution": { "$ref": "#/$defs/lane" },
        "paid_user_acquisition": { "$ref": "#/$defs/lane" },
        "onboarding": { "$ref": "#/$defs/lane" },
        "revenue": { "$ref": "#/$defs/lane" },
        "store_console": { "$ref": "#/$defs/lane" },
        "apple_signing": { "$ref": "#/$defs/lane" },
        "privacy_legal": { "$ref": "#/$defs/lane" },
        "email": { "$ref": "#/$defs/lane" },
        "orchestration": { "$ref": "#/$defs/lane" },
        "engineering": { "$ref": "#/$defs/lane" },
        "growth": { "$ref": "#/$defs/lane" },
        "post_launch_ops": { "$ref": "#/$defs/lane" }
      }
    },
    "founderGates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pending"],
      "properties": {
        "pending": { "type": "array", "items": { "$ref": "#/$defs/pendingFounderGate" } }
      }
    },
    "providers": {
      "$comment": "Optional so pre-providers documents and the bootstrap patch stay valid; migrate-v1 carries the v1 tools: block in here, keys stay the v1 snake_case tool names. accessRoute's enum makes the reducer's schema step reject bad values; the per-provider declared-routes cross-check is a reducer step, not schema.",
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/providerStateEntry" }
    },
    "continuity": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "lastStateReview": { "type": "string" },
        "sourceFiles": { "type": "array", "items": { "type": "string" } },
        "gitStatusReviewed": { "type": "boolean" },
        "nextAction": { "type": "string" }
      }
    },
    "workflowApplicability": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["verdict", "reason", "evidence", "updatedAt"],
        "properties": {
          "verdict": { "enum": ["required", "not-needed"] },
          "reason": { "type": "string", "minLength": 1 },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "$defs": {
    "lane": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "evidence", "blockers"],
      "properties": {
        "status": { "$ref": "urn:formation:core:status-schema#/$defs/status" },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "blockers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "providerStateEntry": {
      "$comment": "Like lane: typed core fields plus provider-specific extras (identity blocks, route_options, tier fields) v1 entries carry, so migration never drops data.",
      "type": "object",
      "additionalProperties": true,
      "required": ["accessRoute"],
      "properties": {
        "accessRoute": { "enum": ["mcp", "api", "cli", "browser", "native_device", "skill_pack", "manual", "not_selected"] },
        "route": { "type": "string" },
        "docsCheckedAt": { "type": "string" },
        "requiredSecrets": { "type": "array", "items": { "type": "string" } },
        "preflight": { "type": "string" },
        "validation": { "type": "string" },
        "fallback": { "type": "string" }
      }
    },
    "pendingFounderGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "reason", "createdAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "category": { "enum": ["spend", "credentials_access", "legal_pricing", "public_actions", "release", "destructive", "other"] },
        "reason": { "type": "string", "minLength": 1 },
        "sourceLegacyId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
