{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:b2c-mobile-business-launch:core:control-schema",
  "title": "Business Control File",
  "$comment": "Kill switch flag + grant map + waivers for one business workspace (R11). The reducer CLI (U3) is designed to be its only writer; the adapter tool allowlist and OS file permissions enforce that from inside a session (KTD7). stateHash is populated by the reducer on every commit for out-of-band tamper detection (R14).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "updatedAt", "businessSlug", "stateHash", "killSwitch", "grants", "waivers"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0.0" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "businessSlug": { "type": "string", "minLength": 1 },
    "stateHash": { "anyOf": [{ "const": "" }, { "type": "string", "minLength": 1 }] },
    "killSwitch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engaged", "engagedAt", "engagedBy", "reason"],
      "properties": {
        "engaged": { "type": "boolean" },
        "engagedAt": { "anyOf": [{ "const": "" }, { "type": "string", "format": "date-time" }] },
        "engagedBy": { "anyOf": [{ "const": "" }, { "enum": ["founder", "system"] }] },
        "reason": { "type": "string" }
      }
    },
    "grants": { "$ref": "urn:b2c-mobile-business-launch:core:grants-schema#/$defs/grantsMap" },
    "waivers": { "$ref": "urn:b2c-mobile-business-launch:core:waivers-schema#/$defs/waiverList" }
  }
}
