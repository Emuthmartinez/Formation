# Server
HOST=127.0.0.1
PORT=4310
NODE_ENV=development
FORMATION_DATA_FILE=platform/data/formation.json

# Credential registration is enabled unless explicitly disabled. Keep it enabled for
# self-serve deployments, or disable it when provisioning accounts through an identity provider.
ALLOW_REGISTRATION=true

# The repository preview uses a local demo account. Keep this false in production.
ALLOW_DEMO_AUTH=false

# Production cookies require HTTPS. Set this true only when TLS terminates at a trusted
# reverse proxy that overwrites X-Forwarded-For, X-Forwarded-Host, and X-Forwarded-Proto.
TRUST_PROXY=false

# Optional structured-generation provider. The endpoint receives company context,
# claims, decisions, existing deliverables, and a response schema as JSON.
FORMATION_AI_ENDPOINT=
FORMATION_AI_API_KEY=
